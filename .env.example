# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored — never commit secrets.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app:localdev@localhost:5432/platform

# "password" for local dev (standard PG auth); "iam" for AWS (RDS IAM auth).
DB_AUTH_MODE=password

# ── AWS / LocalStack ──────────────────────────────────────────────────────────
# Point at LocalStack for local dev; unset (or remove) this var in AWS environments.
AWS_ENDPOINT_URL=http://localhost:4566

# LocalStack accepts any non-empty string for these.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=dev
